<Window x:Class="AstesiaHarness.ViewModels.ClosePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭 AstesiaHarness"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico">
    <StackPanel Margin="16,14,16,16">
        <TextBlock Text="关闭主界面时："
                   FontWeight="SemiBold" Margin="0,0,0,10" />
        <RadioButton x:Name="MinimizeRadio" Content="最小化到托盘（服务保持运行）" GroupName="CloseAction"
                     Margin="4,0,0,6" />
        <RadioButton x:Name="ExitRadio" Content="退出程序" GroupName="CloseAction"
                     Margin="4,0,0,14" />
        <CheckBox x:Name="DontAskCheck" Content="不再提示（记住我的选择）"
                  Margin="4,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="80" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="OkButton" Content="确定" Width="80" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
