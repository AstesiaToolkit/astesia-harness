<Window x:Class="AstesiaHarness.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AstesiaHarness — DeepSeek Harness 快速启动器"
        Width="780" Height="600" MinWidth="660" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FFFFFF"
        Icon="pack://application:,,,/Assets/app.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 标题栏窗口按钮 -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D8DEE6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A4A5E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E3B4C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 更新徽标（有更新时绿色高亮，可点击） -->
        <Style x:Key="UpdateBadgeStyle" TargetType="Button">
            <Setter Property="Background" Value="#1B5E20" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="ToolTip" Value="发现新版本，点击更新" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E7D32" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0E3A12" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 复制按钮：前后相叠的两张纸（自绘矢量） -->
        <Style x:Key="CopyIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="复制地址" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <Viewbox Width="13" Height="13" Margin="0">
                                <Canvas Width="24" Height="24">
                                    <!-- 后层纸（右下偏移、浅色描边） -->
                                    <Rectangle Canvas.Left="8" Canvas.Top="10" Width="11" Height="13"
                                               RadiusX="1.5" RadiusY="1.5"
                                               Stroke="#94A3B8" StrokeThickness="1.6" Fill="#EAF0F6" />
                                    <!-- 前层纸（左上覆盖、深色描边） -->
                                    <Rectangle Canvas.Left="5" Canvas.Top="4" Width="11" Height="13"
                                               RadiusX="1.5" RadiusY="1.5"
                                               Stroke="#475569" StrokeThickness="1.6" Fill="#FFFFFF" />
                                    <!-- 前层纸上的内容线 -->
                                    <Line X1="7.5" Y1="8.5" X2="13.5" Y2="8.5" Stroke="#475569" StrokeThickness="1.1"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Line X1="7.5" Y1="11.5" X2="13.5" Y2="11.5" Stroke="#475569" StrokeThickness="1.1"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Line X1="7.5" Y1="14.5" X2="11.3" Y2="14.5" Stroke="#475569" StrokeThickness="1.1"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── 自定义标题栏（T5：版本显示 + 更新徽标） ───────────── -->
        <Grid Grid.Row="0" Background="#263445">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="AstesiaHarness" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CurrentVersionText}" Foreground="#8FA6BF" FontSize="11"
                           Margin="8,1,0,0" VerticalAlignment="Center" />
                <Button Command="{Binding UpdateNowCommand}"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource UpdateBadgeStyle}"
                        Content="{Binding UpdateBadgeText}"
                        Margin="12,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <Button x:Name="MinButton" Content="&#x2013;" Style="{StaticResource TitleBarButton}" Click="OnMinimizeButton" />
                <Button x:Name="MaxButton" Content="&#x25A1;" Style="{StaticResource TitleBarButton}" Click="OnMaximizeRestoreButton" />
                <Button x:Name="CloseButton" Content="&#x2715;" Style="{StaticResource CloseTitleBarButton}" Click="OnCloseButton" />
            </StackPanel>
        </Grid>

        <!-- ── 状态条 ─────────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="1"
                CornerRadius="4" Padding="10,8" Margin="12,10,12,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <TextBlock Text="URL:" VerticalAlignment="Center" Foreground="#555" />
                    <Button Content="{Binding Url}" Command="{Binding OpenBrowserCommand}"
                            Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}"
                            Background="Transparent" BorderThickness="0" Foreground="#1565C0"
                            Cursor="Hand" Padding="4,0" Margin="2,0,0,0"
                            ToolTip="点击在浏览器中打开" />
                    <Button Style="{StaticResource CopyIconButtonStyle}" Command="{Binding CopyUrlCommand}"
                            ToolTip="复制 URL"
                            Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}"
                            Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding MetaText}" FontSize="11" Foreground="#777" Margin="18,5,0,0" />
                <!-- T7：局域网地址（每个地址独立一行：绿色链接 + 叠纸复制按钮） -->
                <StackPanel Margin="18,4,0,0"
                            Visibility="{Binding HasLanUrl, Converter={StaticResource BoolToVis}}">
                    <!-- <TextBlock Text="局域网地址：" FontSize="11" Foreground="#777" Margin="0,0,0,2" /> -->
                    <ItemsControl ItemsSource="{Binding LanAddresses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                    <Button Content="{Binding Url}" Command="{Binding OpenCommand}"
                                            Background="Transparent" BorderThickness="0" Foreground="#2E7D32"
                                            Cursor="Hand" Padding="2,0" FontSize="11" FontWeight="SemiBold"
                                            ToolTip="点击在浏览器中打开" />
                                    <Button Style="{StaticResource CopyIconButtonStyle}" Command="{Binding CopyCommand}"
                                            ToolTip="复制局域网地址" Margin="4,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── 操作按钮 ───────────────────────────────────────────── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,10,12,0">
            <Button Content="▶ 启动" Command="{Binding StartCommand}" Padding="14,4" Margin="0,0,8,0" />
            <Button Content="■ 停止" Command="{Binding StopCommand}" Padding="14,4" Margin="0,0,8,0" />
            <Button Content="↻ 重启" Command="{Binding RestartCommand}" Padding="14,4" Margin="0,0,8,0" />
            <Button Content="🌐 打开浏览器" Command="{Binding OpenBrowserCommand}" Padding="14,4" />
        </StackPanel>

        <!-- ── Tab：运行 / 设置 ───────────────────────────────────── -->
        <TabControl Grid.Row="3" Margin="12,10,12,0">
            <!-- 运行 -->
            <TabItem Header="运行">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,4,2,6">
                        <Button Content="清空日志" Command="{Binding ClearLogCommand}" Padding="10,2" Margin="0,0,8,0" />
                        <Button Content="复制全部" Command="{Binding CopyLogCommand}" Padding="10,2" Margin="0,0,8,0" />
                        <CheckBox Content="自动滚动" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="LogList"
                             ItemsSource="{Binding Log}"
                             Background="#1E1E1E" Foreground="#D8D8D8"
                             BorderBrush="#333" BorderThickness="1"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                             SelectionMode="Extended"
                             PreviewKeyDown="OnLogPreviewKeyDown"
                             MouseLeftButtonDown="OnLogMouseLeftButtonDown"
                             MouseMove="OnLogMouseMove"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TimeText}" Foreground="#888888" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding TextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- 设置 -->
            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,10,6,10" MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="dsh 来源" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <RadioButton Content="源码仓库（pnpm dsh web，需仓库检出+依赖+dist）" GroupName="DshSource"
                                     IsChecked="{Binding IsSourceRepo}" Margin="6,2,0,2" />
                        <RadioButton Content="全局命令（npm install -g @deepseek-ai/dsh，免源码）" GroupName="DshSource"
                                     IsChecked="{Binding IsGlobalCommand}" Margin="6,2,0,2" />
                        <StackPanel Orientation="Horizontal" Margin="6,2,0,10">
                            <TextBlock Text="dsh 版本：" FontSize="12" Foreground="#666" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DshVersionText}" FontSize="12" Foreground="#444" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="DSH 仓库路径" FontWeight="SemiBold" />
                        <DockPanel Margin="0,4,0,12">
                            <Button DockPanel.Dock="Right" Content="浏览…" Command="{Binding BrowseRepoCommand}" Padding="10,2" Margin="6,0,0,0"
                                    IsEnabled="{Binding IsSourceRepo}" />
                            <TextBox Text="{Binding RepoPath, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnSettingsFieldLostFocus"
                                     IsEnabled="{Binding IsSourceRepo}" />
                        </DockPanel>
                        <TextBlock Text="全局命令模式无需仓库路径（需先执行 npm install -g @deepseek-ai/dsh）。"
                                   FontSize="11" Foreground="#888" Margin="0,-8,0,10"
                                   Visibility="{Binding IsGlobalCommand, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="端口（透传 --port）" FontWeight="SemiBold" />
                        <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,4,0,12" LostFocus="OnSettingsFieldLostFocus" />

                        <TextBlock Text="绑定主机（透传 --host）" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding HostOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                  SelectedValue="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                  Width="220" HorizontalAlignment="Left" Margin="0,4,0,12" />
                        <!-- T7：局域网共享安全横幅 -->
                        <Border Visibility="{Binding LanEnabled, Converter={StaticResource BoolToVis}}"
                                Background="#FDECEA" BorderBrush="#F5C6CB" BorderThickness="1" CornerRadius="3"
                                Padding="8,6" Margin="0,0,0,12">
                            <TextBlock Text="⚠ 当前对局域网开放（0.0.0.0）：局域网内任何设备都可访问本服务并运行工具，SDK 会自动信任局域网 IP、无认证。请仅在可信网络使用。"
                                       Foreground="#B71C1C" FontSize="12" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="附加参数（空格分隔，如 --trusted-host lab.internal）" FontWeight="SemiBold" />
                        <TextBox Text="{Binding ExtraArgs, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" LostFocus="OnSettingsFieldLostFocus" />

                        <CheckBox Content="服务就绪后自动打开浏览器" IsChecked="{Binding AutoOpenBrowser}" Margin="0,2,0,10" />

                        <TextBlock Text="打开方式" FontWeight="SemiBold" Margin="0,2,0,2" />
                        <RadioButton Content="浏览器标签页（已打开时切换已有标签）" GroupName="OpenMode" IsChecked="{Binding IsBrowserTab}"
                                     Margin="6,2,0,2" />
                        <RadioButton Content="Edge 应用窗口（--app=，独立无地址栏）" GroupName="OpenMode" IsChecked="{Binding IsEdgeApp}"
                                     Margin="6,2,0,10" />

                        <TextBlock Text="关闭主界面时" FontWeight="SemiBold" Margin="0,2,0,2" />
                        <RadioButton Content="退出程序" GroupName="CloseAction" IsChecked="{Binding CloseActionIsExit}"
                                     Margin="6,2,0,2" />
                        <RadioButton Content="最小化到托盘（服务保持运行）" GroupName="CloseAction" IsChecked="{Binding CloseActionIsMinimize}"
                                     Margin="6,2,0,2" />
                        <CheckBox Content="退出时提示（每次点 × 询问）" IsChecked="{Binding PromptOnClose}" Margin="6,2,0,10" />

                        <TextBlock Text="打开软件时" FontWeight="SemiBold" Margin="0,2,0,2" />
                        <CheckBox Content="打开软件时同时启动 dsh" IsChecked="{Binding AutoStartServerOnLaunch}" Margin="0,2,0,4" />
                        <CheckBox Content="开机自启（以 --minimized 启动到托盘）" IsChecked="{Binding StartWithWindows}" Margin="0,2,0,14" />

                        <TextBlock Text="版本与更新" FontWeight="SemiBold" Margin="0,2,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="当前版本：" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentVersionText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox Content="启动时自动检查更新" IsChecked="{Binding AutoCheckUpdate}" Margin="0,2,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                            <Button Content="检查更新" Command="{Binding CheckUpdateCommand}" Padding="10,2" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding UpdateStatusText}" VerticalAlignment="Center" Foreground="#555" FontSize="12" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="恢复默认" Command="{Binding ResetSettingsCommand}" Padding="14,4" Margin="0,0,8,0" />
                            <Button Content="打开数据目录" Command="{Binding OpenDataDirCommand}" Padding="14,4" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ── 消息条（T3：支持指引链接） ─────────────────────────── -->
        <Border Grid.Row="4" Margin="12,8,12,12" Padding="8,5" CornerRadius="3"
                Background="#FDF6EC" BorderBrush="#EADFC8" BorderThickness="1">
            <TextBlock TextWrapping="Wrap" FontSize="12">
                <Run Text="{Binding MessageText, Mode=OneWay}" Foreground="{Binding MessageBrush}" />
                <Hyperlink Command="{Binding OpenMessageLinkCommand}">
                    <Run Text="{Binding MessageLinkText, Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
        </Border>
    </Grid>
</Window>
